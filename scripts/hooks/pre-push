#!/bin/sh
# dsh-palm pre-push gate: repo hygiene scan + full test suite + commitlint.
# Runs before every push so leaks and regressions never leave the machine.
#
# The gate itself lives in packages/dsh-palm/scripts/verify.mjs — the same
# implementation `pnpm verify` uses for the full CI mirror, so the hook and
# the runner cannot drift apart.
#
#   --hygiene-rev HEAD      scan the commits being pushed, not the work tree
#   --allow-missing-regex   let a machine without ~/.dsh/repo-guard.regex push
#                           anyway; `pnpm verify` stays strict, so a release
#                           can never pass silently without the scan
#
# The test step strips the proxy environment variables, so exporting a proxy
# in the shell (to reach GitHub) no longer fails the suite.
#
# Enable with: git config core.hooksPath scripts/hooks
set -e

exec node packages/dsh-palm/scripts/verify.mjs --profile push --hygiene-rev HEAD --allow-missing-regex
