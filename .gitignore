node_modules/
lib/
*.tsbuildinfo

# debug probe scripts (may contain pairing cookies)
probe-watch.mjs
probe-ask.mjs

# test coverage output
coverage/
.vitest-cache/

# local CDP verification artifacts (Chrome user-data dirs, test reports)
.chrome-*/
test-report.json

# frame scratch directory for scripts/capture-gif.mjs (removed on exit, but a
# killed run can leave it behind)
.gif-frames/

# local verification scripts with hardcoded deployment addresses
scripts/check-pwa.mjs
scripts/measure-tunnel.mjs

# local gitleaks config contains real network identifiers (do not publish)
.gitleaks.toml

# superpowers workflow artifacts (agentic implementation plans/specs, not shipped)
docs/superpowers/

# PowerShell module-analysis cache (a PS session whose cwd was inside a package)
packages/*/Microsoft/
